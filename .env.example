# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only — never expose to the client

# Anthropic Claude API
ANTHROPIC_API_KEY=           # server-only — never expose to the client

# Web3Forms (public landing page contact form)
WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=    # Web3Forms access keys are designed to be used client-side

# Used server-side to construct absolute URLs where needed (e.g. auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
